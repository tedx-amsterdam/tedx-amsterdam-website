# Copy to .env.local and fill in. .env.local is git ignored.

# Where content comes from: "fixtures" (static test data, no token needed)
# or "webflow" (the live Webflow CMS).
CONTENT_SOURCE=

# Webflow site token with CMS read permission only. Required when
# CONTENT_SOURCE=webflow. Ask the maintainer; never commit it.
WEBFLOW_API_TOKEN=
