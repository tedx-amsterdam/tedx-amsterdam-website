{
  "name": "tedx-amsterdam-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website for tedxamsterdam.nl, built with Next.js and the TEDxAmsterdam design system",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "node scripts/design-system-assets.ts && next dev",
    "build": "node scripts/design-system-assets.ts && next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:output": "vitest run --config vitest.output.config.ts",
    "lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "tedx-amsterdam-design-system": "1.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
