{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "nextjs",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/no-default-export": "error",
    "react/react-in-jsx-scope": "off",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/content/*",
              "**/content/*"
            ],
            "message": "Import content from @/content only. Sources, mappers and fixtures are internal to the content layer."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/not-found.tsx",
        "src/app/**/sitemap.ts",
        "src/app/**/robots.ts",
        "*.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "src/content/**",
        "tests/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "node_modules/**",
    "next-env.d.ts"
  ]
}
